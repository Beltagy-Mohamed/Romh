# Postgres — استخدم دورًا غير مالك ليعمل RLS (راجع db/migrations/0005_roles.sql، D-004)
DATABASE_URL=postgres://fazaa_app:fazaa_app_dev@localhost:5432/fazaa

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-jwt-secret-change-me
JWT_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600

# OTP (الإنتاج: مزود SMS حقيقي قابل للتبديل)
OTP_TTL_SECONDS=300
OTP_DEBUG_DEV_CODE=true

# FCM — فارغ = وضع سجل فقط (stub)
FCM_SERVER_KEY=

# SMS
SMS_PROVIDER=stub
SMS_BUDGET_MONTHLY_EGP=500

PORT=3000
CORS_ORIGIN=*
